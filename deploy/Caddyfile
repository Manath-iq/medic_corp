{$PUBLIC_ORIGIN} {
  encode zstd gzip
  header {
    X-Robots-Tag "noindex, nofollow, noarchive"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
  request_body {
    max_size 20MB
  }
  handle /robots.txt {
    respond <<ROBOTS
User-agent: *
Disallow: /
ROBOTS 200
  }
  # Preserve links stored by the local demo without changing its database.
  handle_path /medic_corp/* {
    redir {uri} 308
  }
  @cms path /admin /admin/* /api/* /_next/* /clinic-logo.webp
  handle @cms {
    reverse_proxy cms:3001
  }
  handle {
    root * /srv/site
    file_server
  }
}
